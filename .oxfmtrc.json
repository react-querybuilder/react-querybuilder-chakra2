{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "arrowParens": "avoid",
  "embeddedLanguageFormatting": "auto",
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false
  },
  "ignorePatterns": [
    // Hidden(ish) files
    "**/.*",
    // Generated
    "*Parser.js",
    // Binaries
    "*.jpeg",
    "*.jpg",
    "*.png",
    "*.svg",
    "bun.lockb",
    // Unsupported
    "*.jison",
    "*.toml",
    "CNAME",
    "*.go",
    "go.mod",
    "go.sum",
    // Misc
    "lerna.json",
    "bun.lock"
  ],
  "overrides": [{
    "files": ["example/**/*.ts{,x}"],
    "options": {
      "printWidth": 80
    }
  }]
}
