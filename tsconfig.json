{
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["node", "web", "bun"],
    "paths": {
      "@react-querybuilder/chakra2": ["./src"]
    }
  },
  "include": ["./*.ts", "./src/", "./dev/"]
}
